# Servidor de contas (servidor/api.mjs). Copie para .env e ajuste.
# O SITE não precisa disto para funcionar: sem servidor, ler, marcar e anotar
# continuam funcionando — só ficam guardados no navegador de cada um.

FIO_PORTA=8787

# Quem pode chamar esta API. Separado por vírgula, sem barra no fim.
FIO_ORIGENS=https://gabrielcavalcantep2307-creator.github.io

# Endereço do site, usado para montar o link de troca de senha.
FIO_SITE=https://gabrielcavalcantep2307-creator.github.io/fio

# Em localhost, o cookie não pode exigir HTTPS. NUNCA use isto em produção.
# FIO_INSEGURO=1

# E-mail (só serve para "esqueci a senha"). Sem chave, o link sai no log do
# servidor em vez de ser enviado — dá para testar sem contratar nada.
FIO_EMAIL_SERVICO=resend
# FIO_EMAIL_CHAVE=re_xxxxxxxx
FIO_EMAIL_DE=Fio <nao-responda@seu-dominio>

# Onde fica o banco.
# FIO_BANCO=/var/lib/fio/catalogo.db
